{
    "compilerOptions": {
        // TypeScript 6 no longer emits ES5; all supported browsers run ES2015
        "target": "es2015",
        // this enables stricter inference for data properties on `this`
        "strict": true,
        // if using webpack 2+ or rollup, to leverage tree shaking:
        "module": "es2015",
        "moduleResolution": "bundler",
        "lib": [
            "dom",
            "es2015",
            "scripthost"
        ]
    },
    "files": [
        "untyped-modules.d.ts"
    ],
    "exclude": [
        "node_modules",
        "vendor"
    ]
}
